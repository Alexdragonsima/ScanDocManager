<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Внешнее свечение луча — оранжевое -->
    <path
        android:strokeColor="#4DF97316"
        android:strokeWidth="16"
        android:strokeLineCap="round"
        android:pathData="M8,54 L100,54" />

    <!-- Средний слой свечения — оранжевый -->
    <path
        android:strokeColor="#80F97316"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M8,54 L100,54" />

    <!-- Ядро луча — градиент оранж → красный -->
    <path android:pathData="M0,52 L108,52 L108,56 L0,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="54"
                android:endX="108"
                android:endY="54"
                android:startColor="#00F97316"
                android:centerColor="#FB923C"
                android:endColor="#00EF4444" />
        </aapt:attr>
    </path>

    <!-- Яркая «вспышка» в центре луча — белая -->
    <path android:pathData="M46,53 L62,53 L62,55 L46,55 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="54"
                android:endX="62"
                android:endY="54"
                android:startColor="#00FFFFFF"
                android:centerColor="#FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Буква S -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M64,42
                          Q64,34 57,34
                          L49,34
                          Q42,34 42,42
                          Q42,48 49,50
                          L59,52
                          Q66,55 66,62
                          Q66,72 59,72
                          L49,72
                          Q42,72 42,64" />
</vector>