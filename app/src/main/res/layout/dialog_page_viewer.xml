<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000">

    <ImageView
        android:id="@+id/fullImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="32dp"
        android:scaleType="fitCenter"
        android:contentDescription="Страница" />

    <TextView
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#80000000"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="1 / 1" />

    <!-- Кнопки внизу -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="@color/white"
            android:contentDescription="Предыдущая"
            app:backgroundTint="#4D000000"
            app:cornerRadius="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="56dp"
            android:minHeight="56dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deletePageButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="🗑"
            android:textSize="22sp"
            android:textColor="@color/white"
            android:contentDescription="Удалить"
            app:backgroundTint="@color/retake_color"
            app:cornerRadius="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="56dp"
            android:minHeight="56dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="→"
            android:textSize="22sp"
            android:textColor="@color/white"
            android:contentDescription="Следующая"
            app:backgroundTint="#4D000000"
            app:cornerRadius="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="56dp"
            android:minHeight="56dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

</FrameLayout>