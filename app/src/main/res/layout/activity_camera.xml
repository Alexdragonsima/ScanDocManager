<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== TOP BAR ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Назад"
                app:tint="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/pageCounterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:background="#59000000"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
            android:text="Готово: 0" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert2"
                android:contentDescription="Ещё"
                app:tint="@color/white" />

            <!-- Скрытые кнопки (управляются из меню ⋯) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hdrButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aiButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ==================== ПРЕВЬЮ / КАМЕРА ==================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.dragonsima.scandoc.OverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/resultImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Кнопка съёмки (видна только в режиме камеры) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/captureButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="32dp"
                android:src="@drawable/ic_camera"
                android:contentDescription="Сделать снимок"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:backgroundTint="@color/primary_color"
                app:tint="@color/white"
                app:borderWidth="3dp"
                app:elevation="8dp"
                app:rippleColor="#33FFFFFF" />
        </FrameLayout>

        <!-- ==================== BOTTOM SHEET ==================== -->
        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:visibility="gone"
            android:elevation="12dp"
            android:paddingTop="4dp">

            <!-- Хедер мультирежима: заголовок + переключатель -->
            <LinearLayout
                android:id="@+id/pagesHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pagesHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Страницы"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/togglePagesButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:icon="@drawable/ic_tune"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Переключить" />
            </LinearLayout>

            <!-- Контейнер миниатюр страниц (мультирежим) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pagesInlineRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- Панель фильтров (горизонтальный скролл) -->
            <HorizontalScrollView
                android:id="@+id/filterPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterOriginal"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Ориг."
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterPhoto"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Фото"
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterColor"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Цвет"
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterGray"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Серый"
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterBW"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Ч/Б"
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterShadow"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Тени"
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterSharp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="64dp"
                        android:maxLines="1"
                        android:text="Резк."
                        android:textSize="11sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:cornerRadius="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Панель действий -->
            <LinearLayout
                android:id="@+id/actionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <!-- 4 кнопки действий: иконка + подпись -->
                <LinearLayout
                    android:id="@+id/actionButtonsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cropButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Обрезать"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:icon="@drawable/ic_crop"
                        app:iconSize="20dp"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:contentDescription="Обрезать" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rotateButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Повернуть"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:icon="@drawable/ic_rotate"
                        app:iconSize="20dp"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:contentDescription="Повернуть" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ocrButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Текст"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:icon="@drawable/ic_text"
                        app:iconSize="20dp"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:contentDescription="Текст" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jpgButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="JPG"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:icon="@drawable/ic_image"
                        app:iconSize="20dp"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        android:contentDescription="JPG" />
                </LinearLayout>

                <!-- Сохранить PDF -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveResultButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:text="Сохранить PDF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:contentDescription="Сохранить"
                    app:icon="@drawable/ic_check"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/save_color"
                    app:cornerRadius="23dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <!-- Переснять — компактная -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retakeButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="0dp"
                    android:text="Переснять"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/retakeLabel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/saveLabel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>