<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
    </androidx.camera.view.PreviewView>

    <com.dragonsima.scandoc.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/resultImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:background="@color/white"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start|end"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Назад"
            android:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:stateListAnimator="@null"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:backgroundTint="#80000000"
            app:cornerRadius="24dp"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aiButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="AI: ВЫКЛ"
            android:textColor="@color/white"
            app:backgroundTint="@color/grey_500"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hdrButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="HDR: ВЫКЛ"
            android:textColor="@color/white"
            app:backgroundTint="@color/grey_500"
            app:cornerRadius="20dp" />


    </LinearLayout>

    <!-- Кнопка съёмки -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/captureButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="📷"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:contentDescription="Сделать снимок"
        app:backgroundTint="@color/primary_color"
        app:cornerRadius="36dp"
        app:strokeColor="@color/white"
        app:strokeWidth="4dp"
        app:iconPadding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        android:elevation="8dp"
        android:minWidth="72dp"
        android:minHeight="72dp"/>

    <!-- ===== НОВАЯ ПАНЕЛЬ ФИЛЬТРОВ ===== -->
    <LinearLayout
        android:id="@+id/filterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterOriginal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Оригинал"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/grey_600"
            app:cornerRadius="16dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Цветной"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_color"
            app:cornerRadius="16dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterBW"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ч/Б"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/grey_600"
            app:cornerRadius="16dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterSharp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Резкость"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/grey_600"
            app:cornerRadius="16dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="2dp"/>
    </LinearLayout>

    <!-- Панель действий (переснять, обрезать, сохранить) -->
    <LinearLayout
        android:id="@+id/actionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/overlay_background"
        android:visibility="gone"
        android:elevation="16dp"
        android:baselineAligned="false">

        <!-- Кнопка Переснять -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retakeButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="🔄"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:contentDescription="Переснять"
                app:backgroundTint="@color/retake_color"
                app:cornerRadius="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:minWidth="48dp"
                android:minHeight="48dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Переснять"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Кнопка Обрезать -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cropButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="✂️"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:contentDescription="Обрезать"
                app:backgroundTint="@color/crop_color"
                app:cornerRadius="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:minWidth="48dp"
                android:minHeight="48dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Обрезать"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Кнопка Сохранить -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:gravity="center"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveResultButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✅ Сохранить"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:contentDescription="Сохранить документ"
                app:backgroundTint="@color/save_color"
                app:cornerRadius="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:minWidth="48dp"
                android:minHeight="48dp"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>