<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.dragonsima.scandoc.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/resultImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:background="@color/white" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Верхняя панель: назад слева, AI и HDR справа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <!-- Кнопка Назад -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Назад"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:backgroundTint="#59000000"
            app:cornerRadius="22dp"
            app:iconPadding="0dp" />

        <!-- Распорка — прижимает следующие кнопки вправо -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- AI-скан -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/aiButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="AI: СКАН"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/grey_500"
            app:cornerRadius="18dp" />

        <!-- HDR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hdrButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="HDR: ВЫКЛ"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/grey_500"
            app:cornerRadius="18dp" />

    </LinearLayout>

    <!-- Кнопка съёмки -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/captureButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="📷"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:contentDescription="Сделать снимок"
        app:backgroundTint="@color/primary_color"
        app:cornerRadius="36dp"
        app:strokeColor="@color/white"
        app:strokeWidth="4dp"
        app:iconPadding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        android:elevation="8dp"
        android:minWidth="72dp"
        android:minHeight="72dp" />

    <!-- ===== НИЖНИЙ БЛОК: фильтры + действия ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Панель фильтров (горизонтальный скролл) -->
        <HorizontalScrollView
            android:id="@+id/filterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterOriginal"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Оригинал"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/grey_600"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterPhoto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Фото"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/grey_600"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterColor"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Цветной"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/primary_color"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterGray"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Серый"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/grey_600"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterBW"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Ч/Б"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/grey_600"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterShadow"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Тени"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/grey_600"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterSharp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="88dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Резкость"
                    android:textColor="@color/white"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:backgroundTint="@color/grey_600"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Панель действий -->
        <LinearLayout
            android:id="@+id/actionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center"
            android:background="@color/overlay_background"
            android:visibility="gone"
            android:baselineAligned="false">

            <!-- Переснять -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top|center_horizontal"
                android:layout_marginEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retakeButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="🔄"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:contentDescription="Переснять"
                    app:backgroundTint="@color/retake_color"
                    app:cornerRadius="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:minWidth="56dp"
                    android:minHeight="56dp"
                    android:padding="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Переснять"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="6dp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Обрезать -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top|center_horizontal"
                android:layout_marginEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cropButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="✂️"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:contentDescription="Обрезать"
                    app:backgroundTint="@color/crop_color"
                    app:cornerRadius="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:minWidth="56dp"
                    android:minHeight="56dp"
                    android:padding="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обрезать"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="6dp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Сохранить -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top|center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveResultButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="✅"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:contentDescription="Сохранить документ"
                    app:backgroundTint="@color/save_color"
                    app:cornerRadius="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:minWidth="56dp"
                    android:minHeight="56dp"
                    android:padding="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сохранить"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="6dp"
                    android:maxLines="1" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>