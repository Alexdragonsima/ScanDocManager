<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:gravity="center_horizontal"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <!-- Верхний отступ -->
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Иконка замка -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_lock"
        app:tint="?attr/colorPrimary"
        android:contentDescription="" />

    <!-- Заголовок -->
    <TextView
        android:id="@+id/pinTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pin_enter_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <!-- Подсказка -->
    <TextView
        android:id="@+id/pinSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pin_enter_subtitle"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center" />

    <!-- Точки PIN -->
    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center" />

    <!-- Сообщение об ошибке -->
    <TextView
        android:id="@+id/pinErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/retake_color"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Кнопка биометрии (опционально, скроем если не поддерживается) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/biometricButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pin_use_biometric"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Клавиатура -->
    <GridLayout
        android:id="@+id/pinKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="32dp" />
</LinearLayout>